# Server Configuration
# server.js listens on 10000 when PORT is unset (utils/port.js), the same value as
# render.yaml and the client's VITE_API_URL in client/.env.example.
PORT=10000
NODE_ENV=development
# Required. The frontend origin (scheme://host[:port], no path or trailing slash; https
# when NODE_ENV=production): always an allowed CORS and Socket.IO origin, and the target
# of the redirect after the GitHub callback
CLIENT_URL=http://localhost:5173

# Required. GitHub OAuth App for repository access (not the GitHub sign-in provider in
# Supabase). The server refuses to start with these placeholder values.
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Required. Must equal the OAuth App's callback URL and end in /auth/github/callback:
# normally this server's /auth/github/callback (the client's /auth/github/callback route
# forwards to it as well). https when NODE_ENV=production.
GITHUB_REDIRECT_URI=http://localhost:10000/auth/github/callback
# Optional: timeout of every GitHub API call except token revocation, 1000-60000 ms
GITHUB_TIMEOUT_MS=10000
# Optional overrides (used by the offline tests); defaults https://github.com and https://api.github.com.
# They never change the git clone URL, which is always https://github.com/<owner>/<repo>.git
GITHUB_OAUTH_BASE_URL=
GITHUB_API_BASE_URL=

# GitHub token store (required). GitHub OAuth tokens are kept only on the server,
# encrypted with AES-256-GCM, keyed by the Supabase user id.
#   supabase: table public.github_connections (run supabase/migrations/20261103000000_github_connections.sql)
#   memory:   in-process only; every connection is lost on restart (development and tests)
GITHUB_TOKEN_STORE=memory
# Standard base64 for exactly 32 random bytes: openssl rand -base64 32
GITHUB_TOKEN_ENC_KEY=

# Supabase (server-side verification of user access tokens)
# Project URL, e.g. https://<project>.supabase.co (http allowed only for localhost/127.0.0.1)
SUPABASE_URL=
# Public anon key, the same value as the client's VITE_SUPABASE_ANON_KEY
SUPABASE_ANON_KEY=
# Service-role key, required only when GITHUB_TOKEN_STORE=supabase. It bypasses RLS:
# the server uses it only for the github_connections table. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Database (analysis sessions, generated files and AI call records)
# Required: memory (sessions are lost on every restart; tests and quick local runs only)
# or database (Postgres through Prisma; use this in production)
SESSION_STORE=memory
# With SESSION_STORE=database: Supabase dashboard -> Connect -> "Session pooler" string
# (port 5432 on the pooler host: it works over IPv4, unlike the direct host).
# Prisma owns analysis_sessions, generated_files and ai_calls; apply its migrations with
#   npm run db:deploy
# Never run `npm run db:migrate:dev` against Supabase: it is for local databases only and
# refuses any other host (against Supabase it would offer to reset the database).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Connection pool size per server process (1-20)
DATABASE_POOL_MAX=5
# TLS: for any non-local host the server always uses TLS and verifies the certificate,
# whatever sslmode says (sslmode=require above is for the Prisma CLI). Supabase's
# certificate is signed by Supabase's own CA: download it (Database settings -> SSL
# Configuration) and point this at the file if the connection fails verification.
DATABASE_SSL_CA_FILE=
# INSECURE: true disables certificate verification (logged as a warning at startup).
# Prefer DATABASE_SSL_CA_FILE.
DATABASE_SSL_INSECURE_SKIP_VERIFY=false

# AI providers
# The agents ask for a task (planner, generator, verifier); these settings decide which
# providers serve it, in order. Changing provider or model is a configuration change only.
# WARNING: repository content, including private repositories, is sent to these providers.
# Free tiers may use prompts for training: use paid tiers or providers that do not train
# on prompts before real users connect private repositories.
#
# Required: default fallback chain (comma-separated; gemini, groq, openrouter, novita)
AI_PROVIDERS=gemini,groq,openrouter
# Optional per-task chains (default: AI_PROVIDERS)
# AI_ROUTE_PLANNER=gemini,groq
# AI_ROUTE_GENERATOR=gemini,openrouter
# AI_ROUTE_VERIFIER=groq,gemini
#
# Key and model are required for every provider that appears in a chain. Model IDs are
# never defaulted: pick a current ID from the provider's model list.
# <NAME>_BASE_URL is optional (tests and proxies). <NAME>_JSON_MODE is how structured
# output is requested: json_object (default), json_schema or prompt. Run
# RUN_LIVE_AI=1 npm run ai:smoke to check which mode each model supports.
#
# Gemini models: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=your-gemini-model-id
GEMINI_BASE_URL=
GEMINI_JSON_MODE=json_object
# Groq models: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=your-groq-model-id
GROQ_BASE_URL=
GROQ_JSON_MODE=json_object
# OpenRouter models: https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=your-openrouter-model-id
OPENROUTER_BASE_URL=
OPENROUTER_JSON_MODE=json_object
# deny (default): route only to upstreams that do not store or train on prompts
OPENROUTER_DATA_COLLECTION=deny
# Novita models: https://novita.ai/models
NOVITA_API_KEY=
NOVITA_MODEL=your-novita-model-id
NOVITA_BASE_URL=
NOVITA_JSON_MODE=json_object
#
# Per-attempt timeout (1000-300000 ms), total time per call across all attempts and
# providers (>= AI_TIMEOUT_MS), and attempts per provider before falling back (1-5)
AI_TIMEOUT_MS=60000
AI_CALL_BUDGET_MS=180000
AI_MAX_ATTEMPTS_PER_PROVIDER=2

# Clone limits (optional): git timeout in ms (default 120000) and maximum repository
# size in MB (default 200), read by utils/git.js
# CLONE_TIMEOUT_MS=120000
# MAX_REPO_SIZE_MB=200

# Legacy generator only: read by server/index.js, which server.js never loads
# (only test.js imports it: npm run test:legacy). Not part of the analysis pipeline.
TAVILY_API_KEY=your-tavily-api-key
MEM0_API_KEY=your-mem0-api-key
KEYWORDS_AI_API_KEY=your-keywords-ai-api-key

# Not read by any server code: clones always go to temp/<session id>/repo
REPO_STORAGE_DIR=./temp/repos

# Not read by any server code: every request is logged (utils/security.js requestLogger)
ENABLE_REQUEST_LOGGING=true

# Optional: more allowed browser origins for CORS and Socket.IO, comma-separated, each
# exactly scheme://host[:port] (http or https; no path, wildcard or trailing slash).
# CLIENT_URL's origin is always allowed, and http://localhost:5173 outside production.
CORS_ALLOWED_ORIGINS=

# Optional: the number of reverse proxies in front of the server, 0-3 (default 0). The
# client IP for rate limits is the address that many proxies back in X-Forwarded-For.
# Check req.ip on your host before setting it; never more than the real hop count.
TRUST_PROXY=0

# Optional rate-limit counts (positive integers up to 100000); windows are fixed and
# limiting cannot be switched off. Defaults:
# RATE_LIMIT_PREAUTH_MAX=300          every /api request, per IP, per 5 min
# RATE_LIMIT_USER_MAX=120             every authenticated /api request, per user, per 1 min
# RATE_LIMIT_GITHUBPROXY_MAX=60       GitHub repository routes, per user, per 1 min
# RATE_LIMIT_CLONE_MAX=10             POST /api/clone-repo, per user, per 10 min
# RATE_LIMIT_ANALYSIS_MAX=5           POST /api/analyze, per user, per 5 min
# RATE_LIMIT_OAUTH_MAX=30             /auth/github routes, per IP, per 10 min
# RATE_LIMIT_SOCKETHANDSHAKE_MAX=60   Socket.IO connections, per IP, per 1 min

# Not read by any server code
SESSION_SECRET=your-session-secret-key
TOKEN_EXPIRY=86400 # Not read by any server code

# Not read by any server code: Socket.IO always runs, on its default path
ENABLE_WEBSOCKETS=true
WS_PATH=/socket.io

# Background analyses (utils/jobs.js), per server process: how many run at once (1-8)
# and how many may wait for a slot (0-100). When both are full, POST /api/analyze
# answers 503 ANALYSIS_BUSY and the cloned session can be retried.
# ANALYSIS_CONCURRENCY=2
# ANALYSIS_QUEUE_MAX=20

# Operator metrics: /api/metrics and /api/analytics return 404 unless this is set
# (32+ random characters) and sent as the X-Metrics-Token header. A value shorter than
# 32 characters is a startup error; leave it empty to disable the endpoints.
METRICS_TOKEN=
