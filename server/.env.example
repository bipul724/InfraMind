# Server Configuration
PORT=10000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# GitHub Configuration (for repository operations)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:10000/auth/github/callback
# Optional overrides (used by the offline tests); defaults https://github.com and https://api.github.com.
# They never change the git clone URL, which is always https://github.com/<owner>/<repo>.git
GITHUB_OAUTH_BASE_URL=
GITHUB_API_BASE_URL=

# GitHub token store (required). GitHub OAuth tokens are kept only on the server,
# encrypted with AES-256-GCM, keyed by the Supabase user id.
#   supabase: table public.github_connections (run supabase/migrations/20261103000000_github_connections.sql)
#   memory:   in-process only; every connection is lost on restart (development and tests)
GITHUB_TOKEN_STORE=memory
# Standard base64 for exactly 32 random bytes: openssl rand -base64 32
GITHUB_TOKEN_ENC_KEY=

# Supabase (server-side verification of user access tokens)
# Project URL, e.g. https://<project>.supabase.co (http allowed only for localhost/127.0.0.1)
SUPABASE_URL=
# Public anon key, the same value as the client's VITE_SUPABASE_ANON_KEY
SUPABASE_ANON_KEY=
# Service-role key, required only when GITHUB_TOKEN_STORE=supabase. It bypasses RLS:
# the server uses it only for the github_connections table. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# AI & External Services
LLAMA_API_KEY=your-novita-ai-api-key
LLAMA_API_URL=https://api.novita.ai/v1/chat/completions
# Optional: OpenAI-compatible base URL for the agents (default https://api.novita.ai/v3/openai)
LLAMA_API_BASE_URL=
TAVILY_API_KEY=your-tavily-api-key
MEM0_API_KEY=your-mem0-api-key
KEYWORDS_AI_API_KEY=your-keywords-ai-api-key

# File System Configuration
REPO_STORAGE_DIR=./temp/repos

# Logging Configuration
ENABLE_REQUEST_LOGGING=true

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-url.com

# Security Configuration
SESSION_SECRET=your-session-secret-key
TOKEN_EXPIRY=86400 # 24 hours in seconds

# WebSocket Configuration
ENABLE_WEBSOCKETS=true
WS_PATH=/socket.io

# Operator metrics: /api/metrics and /api/analytics return 404 unless this is set
# (32+ random characters) and sent as the X-Metrics-Token header
METRICS_TOKEN=
