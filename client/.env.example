# InfraMind frontend configuration: copy to .env.local for local development.
# Only these three VITE_* values are read by the app; Vite includes them in the browser build.

# Required: the same Supabase project URL the server uses, from Project Settings -> API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Required: the project's public anon/publishable key, never a service-role or sb_secret_ key,
# because this value is included in browser JavaScript.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend origin, used for /api/*, /auth/github and Socket.IO. The development default
# http://localhost:10000 matches server/.env.example and the app's fallback when unset.
VITE_API_URL=http://localhost:10000

# Render requires all three values in its environment before the frontend build.
# Use HTTPS deployment URLs; VITE_API_URL must be an origin with no path, query, fragment or trailing slash.
# The deployment guard reads process.env only, so .env.local is not a source for that check.
# Leave NODE_ENV unset or set it to production for deployment: development includes error details.
# Restart the dev server or rebuild after changing any VITE_* value, because Vite inlines it.
