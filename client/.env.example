# InfraMind Frontend Configuration

# ===========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ===========================================

# Supabase Project URL
# Get this from Project Settings -> API Keys in the Supabase dashboard
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key - safe to expose in the browser
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===========================================
# API CONFIGURATION
# ===========================================

# Backend API URL (adjust if running backend on different port/host)
VITE_API_URL=http://localhost:3000

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================

# Environment
VITE_NODE_ENV=development

# Enable development mode features
VITE_DEV_MODE=true

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Analytics (if using)
VITE_ANALYTICS_ID=your_analytics_id_here

# Sentry (for error tracking)
VITE_SENTRY_DSN=your_sentry_dsn_here

# ===========================================
# NOTES
# ===========================================
#
# 1. Copy this file to .env.local and fill in your values
# 2. .env.local is ignored by git for security
# 3. VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are required for authentication
# 4. Variables must be prefixed with VITE_ to be available in the browser
# 5. Restart dev server after changing environment variables
#
