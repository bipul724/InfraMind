# InfraMind Frontend Configuration

# ===========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ===========================================

# Supabase Project URL
# Get this from Project Settings -> API Keys in the Supabase dashboard
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key - safe to expose in the browser
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===========================================
# API CONFIGURATION
# ===========================================

# Backend API URL: the Express server's URL, used for /api/*, /auth/github and Socket.IO.
# 10000 matches PORT in server/.env.example. Without VITE_API_URL the client also uses
# http://localhost:10000 (src/lib/api.ts), and the server listens on 10000 when PORT is unset.
VITE_API_URL=http://localhost:10000

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================

# Not read by any client code
VITE_NODE_ENV=development

# Not read by any client code
VITE_DEV_MODE=true

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Not read by any client code (no analytics integration exists)
VITE_ANALYTICS_ID=your_analytics_id_here

# Not read by any client code (no Sentry integration exists)
VITE_SENTRY_DSN=your_sentry_dsn_here

# ===========================================
# NOTES
# ===========================================
#
# 1. Copy this file to .env.local and fill in your values
# 2. .env.local is ignored by git (*.local in client/.gitignore)
# 3. VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are required for authentication.
#    The app reads only VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY and VITE_API_URL
#    (src/lib/agentApi.ts also reads VITE_SERVER_URL, but no route uses that file)
# 4. Variables must be prefixed with VITE_ to be available in the browser
# 5. Restart dev server after changing environment variables
#
